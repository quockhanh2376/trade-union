{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trade Union Group Manager",
  "version": "2.0.2",
  "identifier": "com.aswhite.tradeunion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Trade Union Group Manager",
        "width": 1200,
        "height": 780,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "scripts/manage_distribution_group.ps1",
      "scripts/detect_group_type.ps1",
      "vendor/powershell-modules"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "wix": {
        "upgradeCode": "142d4337-ebfa-5a2e-a5f7-33592dce26d6"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks/clean-install.nsh"
      }
    }
  }
}
